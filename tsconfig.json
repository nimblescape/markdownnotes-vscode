// The type check (npm run typecheck) with TypeScript 6.0, the same in every nimblescape extension: strict, and no
// output, because esbuild builds the bundles. ESLint (npm run lint) reads the types of the same files. The scripts of
// the views have their own settings with the types of the browser (src/webview/ and media/).
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "media/*.test.ts", "media/raw.d.ts"],
  "exclude": ["src/webview/**"]
}
