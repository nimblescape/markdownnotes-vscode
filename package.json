{
  "name": "nimblescape-markdown-notes",
  "displayName": "nimblescape Markdown Notes",
  "description": "Notes in Markdown files, written as HTML comments: threads of answers with their authors and dates. The text editor shows each note in a box that edits it as Markdown, the Markdown preview shows an icon with a callout, and a side view edits and answers the notes. Every change goes back into the comment in the file.",
  "publisher": "nimblescape",
  "author": {
    "name": "nimblescape e.U.",
    "url": "https://nimblescape.com"
  },
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "notes",
    "comments",
    "callout",
    "review"
  ],
  "license": "MIT",
  "homepage": "https://nimblescape.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/nimblescape/nimblescape-markdown-notes.git"
  },
  "bugs": {
    "url": "https://github.com/nimblescape/nimblescape-markdown-notes/issues"
  },
  "pricing": "Free",
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#e8eef6",
    "theme": "light"
  },
  "preview": true,
  "qna": "https://github.com/nimblescape/nimblescape-markdown-notes/issues",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:vscode": "node esbuild.mjs && node scripts/build-vscode-tests.mjs && vscode-test --label vscode",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package --no-dependencies",
    "install-local": "node scripts/install-local.mjs",
    "uninstall-local": "node scripts/uninstall-local.mjs"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "@types/vscode": "~1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "markdown-it": "^14.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onUri"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "The extension reads the notes of open Markdown files and changes a file only when you add, edit, answer or delete a note. It runs no program of the workspace."
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/markdownPreview.css"
    ],
    "markdown.previewScripts": [
      "./media/markdownPreview.js"
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nimblescape-markdown-notes",
          "title": "Markdown Notes",
          "icon": "resources/notes-view.svg"
        }
      ]
    },
    "views": {
      "nimblescape-markdown-notes": [
        {
          "type": "webview",
          "id": "nimblescape.markdownNotes.notes",
          "name": "Notes"
        }
      ]
    },
    "commands": [
      {
        "command": "nimblescape.markdownNotes.addNote",
        "title": "Add Note",
        "category": "Markdown Notes"
      },
      {
        "command": "nimblescape.markdownNotes.discardNewNote",
        "title": "Cancel",
        "category": "Markdown Notes"
      },
      {
        "command": "nimblescape.markdownNotes.answer",
        "title": "Answer",
        "category": "Markdown Notes"
      },
      {
        "command": "nimblescape.markdownNotes.editAnswer",
        "title": "Edit",
        "category": "Markdown Notes",
        "icon": "$(edit)"
      },
      {
        "command": "nimblescape.markdownNotes.deleteAnswer",
        "title": "Delete",
        "category": "Markdown Notes",
        "icon": "$(trash)"
      },
      {
        "command": "nimblescape.markdownNotes.saveAnswer",
        "title": "Save",
        "category": "Markdown Notes"
      },
      {
        "command": "nimblescape.markdownNotes.cancelEdit",
        "title": "Cancel",
        "category": "Markdown Notes"
      },
      {
        "command": "nimblescape.markdownNotes.deleteNote",
        "title": "Delete Thread",
        "category": "Markdown Notes",
        "icon": "$(trash)"
      },
      {
        "command": "nimblescape.markdownNotes.showInPreview",
        "title": "Show Notes in Preview",
        "category": "Markdown Notes",
        "icon": "$(eye)"
      },
      {
        "command": "nimblescape.markdownNotes.hideInPreview",
        "title": "Hide Notes in Preview",
        "category": "Markdown Notes",
        "icon": "$(eye-closed)"
      },
      {
        "command": "nimblescape.markdownNotes.hideNotes",
        "title": "Hide Notes",
        "category": "Markdown Notes",
        "icon": "$(close)"
      },
      {
        "command": "nimblescape.markdownNotes.toggleNotes",
        "title": "Show or Hide Notes",
        "category": "Markdown Notes"
      }
    ],
    "menus": {
      "comments/commentThread/context": [
        {
          "command": "nimblescape.markdownNotes.addNote",
          "group": "inline@1",
          "when": "commentController == nimblescape.markdownNotes && commentThreadIsEmpty"
        },
        {
          "command": "nimblescape.markdownNotes.answer",
          "group": "inline@1",
          "when": "commentController == nimblescape.markdownNotes && !commentThreadIsEmpty"
        },
        {
          "command": "nimblescape.markdownNotes.discardNewNote",
          "group": "inline@2",
          "when": "commentController == nimblescape.markdownNotes && commentThreadIsEmpty"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "nimblescape.markdownNotes.deleteNote",
          "group": "inline",
          "when": "commentController == nimblescape.markdownNotes && commentThread == nimblescape.markdownNotes.note"
        }
      ],
      "comments/comment/title": [
        {
          "command": "nimblescape.markdownNotes.editAnswer",
          "group": "inline@1",
          "when": "commentController == nimblescape.markdownNotes && comment == nimblescape.markdownNotes.note"
        },
        {
          "command": "nimblescape.markdownNotes.deleteAnswer",
          "group": "inline@2",
          "when": "commentController == nimblescape.markdownNotes && comment == nimblescape.markdownNotes.note"
        }
      ],
      "comments/comment/context": [
        {
          "command": "nimblescape.markdownNotes.saveAnswer",
          "group": "inline@1",
          "when": "commentController == nimblescape.markdownNotes"
        },
        {
          "command": "nimblescape.markdownNotes.cancelEdit",
          "group": "inline@2",
          "when": "commentController == nimblescape.markdownNotes"
        }
      ],
      "editor/title": [
        {
          "command": "nimblescape.markdownNotes.showInPreview",
          "group": "navigation",
          "when": "activeWebviewPanelId == 'markdown.preview' && !config.nimblescape.markdownNotes.showInPreview"
        },
        {
          "command": "nimblescape.markdownNotes.hideInPreview",
          "group": "navigation",
          "when": "activeWebviewPanelId == 'markdown.preview' && config.nimblescape.markdownNotes.showInPreview"
        }
      ],
      "view/title": [
        {
          "command": "nimblescape.markdownNotes.hideNotes",
          "group": "navigation",
          "when": "view == nimblescape.markdownNotes.notes && activeAuxiliary != 'workbench.view.extension.nimblescape-markdown-notes' && activePanel != 'workbench.view.extension.nimblescape-markdown-notes'"
        }
      ],
      "commandPalette": [
        {
          "command": "nimblescape.markdownNotes.addNote",
          "when": "false"
        },
        {
          "command": "nimblescape.markdownNotes.discardNewNote",
          "when": "false"
        },
        {
          "command": "nimblescape.markdownNotes.answer",
          "when": "false"
        },
        {
          "command": "nimblescape.markdownNotes.editAnswer",
          "when": "false"
        },
        {
          "command": "nimblescape.markdownNotes.deleteAnswer",
          "when": "false"
        },
        {
          "command": "nimblescape.markdownNotes.saveAnswer",
          "when": "false"
        },
        {
          "command": "nimblescape.markdownNotes.cancelEdit",
          "when": "false"
        },
        {
          "command": "nimblescape.markdownNotes.deleteNote",
          "when": "false"
        },
        {
          "command": "nimblescape.markdownNotes.showInPreview",
          "when": "!config.nimblescape.markdownNotes.showInPreview"
        },
        {
          "command": "nimblescape.markdownNotes.hideInPreview",
          "when": "config.nimblescape.markdownNotes.showInPreview"
        },
        {
          "command": "nimblescape.markdownNotes.hideNotes",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "nimblescape Markdown Notes",
      "properties": {
        "nimblescape.markdownNotes.expandInEditor": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "Open the box of each note in the text editor when the file opens. The value `false` shows only a mark at the lines of each note; a click on the mark opens the box."
        },
        "nimblescape.markdownNotes.showInPreview": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Show the notes as icons with callouts in the Markdown preview. The value `false` shows the preview without the notes; the text around an inline note stays one paragraph."
        }
      }
    }
  },
  "allowScripts": {
    "esbuild": true,
    "@vscode/vsce-sign": true,
    "fsevents": false
  }
}
